@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The headers shared by all PhysiCore modules (the target PhysiCore::common) are installed and
# exported with the BioFVM package; a target can only be exported by one package.
find_dependency(BioFVM CONFIG)

# For static builds, find all transitive dependencies
# For shared builds, dependencies are embedded in the shared library
if(NOT @BUILD_SHARED_LIBS@)
  # Dependencies of the library itself: VTK output and reading of settings files
  find_dependency(VTK CONFIG)
  find_dependency(pugixml CONFIG)

  # OpenMP solver; the solver also builds without OpenMP
  find_dependency(OpenMP 4)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MicromechanicsTargets.cmake")
